# ------------------------------------------------------------ materials --
func _std(c: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = 0.95
	return m


func _glow(c: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.albedo_color = c
	return m


func _pbr(base: String, u := 6.0, v := 3.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = load(PRO + base + ".png") as Texture2D
	m.normal_enabled = true
	m.normal_texture = load(PRO + base + "_n.png") as Texture2D
	m.roughness = 1.0
	m.roughness_texture = load(PRO + base + "_r.png") as Texture2D
	m.uv1_scale = Vector3(u, v, 1.0)
	return m


func _tex_mat(path: String, tint: Color, unshaded := true, alpha := false) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = load(path) as Texture2D
	m.albedo_color = tint
	if unshaded:
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
	if alpha:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	return m


func _build_materials() -> void:
	_mats["brick"] = _pbr("wall_brick", 9.0, 4.0)
	_mats["asphalt"] = _pbr("asphalt_wet", 14.0, 4.0)
	_mats["shutter"] = _pbr("shutter", 2.0, 2.0)
	_mats["roof"] = _pbr("roof_concrete", 10.0, 4.0)
	_mats["steel"] = _std(Color(0.16, 0.18, 0.24))
	_mats["dark"] = _std(Color(0.04, 0.045, 0.08))
	_mats["sand"] = _std(Color(0.45, 0.38, 0.27))
	_mats["barrier_w"] = _std(Color(0.85, 0.85, 0.88))
	_mats["barrier_r"] = _std(Color(0.75, 0.12, 0.12))
	_mats["win_lit"] = _glow(Color(0.95, 0.75, 0.4))
	_mats["win_dark"] = _std(Color(0.06, 0.07, 0.12))
	_mats["siren_r"] = _glow(Color(1.0, 0.12, 0.12))
	_mats["siren_b"] = _glow(Color(0.15, 0.35, 1.0))
	_mats["lamp_head"] = _glow(Color(1.0, 0.75, 0.4))
	_mats["gate_g"] = _glow(Color(0.15, 1.0, 0.35))
	# storm-tinted reused cairo backdrop art
	_mats["sky"] = _tex_mat(CAIRO + "sky.png", Color(0.45, 0.52, 0.7))
	_mats["far"] = _tex_mat(CAIRO + "skyline_far.png", Color(0.5, 0.56, 0.75), true, true)
	_mats["mid"] = _tex_mat(CAIRO + "skyline_mid.png", Color(0.5, 0.55, 0.72), true, true)
	# lightning wash sheet (starts invisible)
	var fq := _glow(Color(0.9, 0.94, 1.0, 0.0))
	fq.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_mats["flash"] = fq
	# fake volumetric cones
	var cone := _glow(Color(1.0, 0.8, 0.45, 0.14))
	cone.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	cone.cull_mode = BaseMaterial3D.CULL_DISABLED
	_mats["cone"] = cone
	var beam := _glow(Color(1.0, 0.2, 0.15, 0.28))
	beam.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	beam.cull_mode = BaseMaterial3D.CULL_DISABLED
	_mats["beam"] = beam


# ---------------------------------------------- environment, weather ----
func _build_environment() -> void:
	var env := Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = Color(0.03, 0.045, 0.09)
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(0.16, 0.2, 0.34)
	env.ambient_light_energy = 0.55
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_EXPONENTIAL
	env.fog_density = 0.016  # the smog is thick tonight
	env.fog_light_color = Color(0.08, 0.1, 0.2)
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)

	# cold steel-blue storm light; lightning rides on top of this base
	_storm = DirectionalLight3D.new()
	_storm.light_color = Color(0.55, 0.62, 0.9)
	_storm.light_energy = 0.35
	_storm.rotation = Vector3(-0.7, 0.4, 0.0)
	_storm.shadow_enabled = true
	_storm.directional_shadow_max_distance = 90.0
	add_child(_storm)


func _rain_emitter(center: Vector3, extents: Vector3, count: int) -> void:
	var p := CPUParticles3D.new()
	p.amount = count
	p.lifetime = 1.1
	p.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	p.emission_box_extents = extents
	p.direction = Vector3(0.22, -1.0, 0.0)
	p.spread = 2.0
	p.initial_velocity_min = 23.0
	p.initial_velocity_max = 29.0
	p.gravity = Vector3.ZERO
	var streak := BoxMesh.new()
	streak.size = Vector3(0.014, 0.5, 0.014)
	var sm := StandardMaterial3D.new()
	sm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	sm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	sm.albedo_color = Color(0.65, 0.75, 0.95, 0.4)
	streak.material = sm
	p.draw_pass_1 = streak
	p.position = center
	add_child(p)


func _build_weather() -> void:
	_rain_emitter(Vector3(46.0, 13.0, -1.0), Vector3(62.0, 1.5, 7.0), 470)
	_rain_emitter(Vector3(129.0, 15.0, -1.0), Vector3(24.0, 1.5, 7.0), 260)
	# lightning wash sheet high behind the skyline
	_flash_quad = MeshInstance3D.new()
	var q := QuadMesh.new()
	q.size = Vector2(260.0, 130.0)
	_flash_quad.mesh = q
	_flash_quad.material_override = _mats["flash"]
	_flash_quad.position = Vector3(68.0, 45.0, -58.0)
	add_child(_flash_quad)


func _process(delta: float) -> void:
	# twin siren blink
	_siren_t += delta
	if _siren_red != null:
		var red_on := fposmod(_siren_t * 2.6, 2.0) < 1.0
		_siren_red.visible = red_on
		_siren_blue.visible = not red_on
		_siren_light.light_color = Color(1.0, 0.12, 0.12) if red_on else Color(0.15, 0.35, 1.0)
	# lightning
	_bolt_timer -= delta
	if _bolt_timer <= 0.0:
		_bolt_timer = randf_range(6.0, 13.0)
		_flash = randf_range(0.35, 0.6)
	if _flash > 0.0:
		_flash = maxf(_flash - delta, 0.0)
		var flicker := 0.6 + 0.4 * sin(_flash * 71.0)
		_storm.light_energy = 0.35 + _flash * 9.0 * flicker
		(_mats["flash"] as StandardMaterial3D).albedo_color.a = _flash * 0.55
	# flatline trace
	if _ecg_t >= 0.0:
		_ecg_t += delta
		var v := _ecg_sample(_ecg_t)
		_ecg_vals.append(v)
		if _ecg_vals.size() > 240:
			_ecg_vals.remove_at(0)
		_redraw_ecg()


# -------------------------------------------------- parallax backdrop ----
func _parallax(stick: float, pos: Vector3) -> Node3D:
	var p := Node3D.new()
	p.set_script(PARALLAX)
	p.set("stick", stick)
	p.position = pos
	add_child(p)
	return p


func _quad(parent: Node3D, mat: Material, x: float, y: float, w: float, h: float, z: float, flip_x := false) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var qm := QuadMesh.new()
	qm.size = Vector2(w, h)
	mi.mesh = qm
	mi.material_override = mat
	mi.position = Vector3(x, y, z)
	if flip_x:
		mi.scale.x = -1.0
	parent.add_child(mi)
	return mi


func _build_parallax_backdrop() -> void:
	var sky := _parallax(0.93, Vector3(70.0, 42.0, -62.0))
	_quad(sky, _mats["sky"], 0.0, 0.0, 330.0, 130.0, 0.0)
	var far := _parallax(0.72, Vector3(70.0, 14.5, -44.0))
	_quad(far, _mats["far"], -95.0, 0.0, 170.0, 31.9, 0.0)
	_quad(far, _mats["far"], 80.0, 0.0, 170.0, 31.9, 0.0, true)
	_quad(far, _mats["far"], 235.0, 0.0, 170.0, 31.9, 0.0)
	var mid := _parallax(0.50, Vector3(70.0, 12.4, -27.0))
	_quad(mid, _mats["mid"], -66.0, 0.0, 130.0, 28.4, 0.0)
	_quad(mid, _mats["mid"], 66.0, 0.0, 130.0, 28.4, 0.0, true)
	_quad(mid, _mats["mid"], 196.0, 0.0, 130.0, 28.4, 0.0)


# ------------------------------------------------------------ geometry ----
func _slab(x0: float, x1: float, top: float, h: float, d: float, mat: Material, zc := 0.0) -> StaticBody3D:
	var w := x1 - x0
	var b := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(w, h, d)
	cs.shape = shape
	b.add_child(cs)
	var mi := MeshInstance3D.new()
	var mesh := BoxMesh.new()
	mesh.size = Vector3(w, h, d)
	mi.mesh = mesh
	mi.material_override = mat
	b.add_child(mi)
	b.position = Vector3((x0 + x1) * 0.5, top - h * 0.5, zc)
	add_child(b)
	return b


const STREET_RUNS := [[-10.0, 56.0], [59.0, 112.0]]  # street continues under the scaffold

func _build_street() -> void:
	for run in STREET_RUNS:
		var x0: float = run[0]
		var x1: float = run[1]
		_slab(x0, x1, 0.0, 1.0, 4.0, _mats["asphalt"])
		_slab(x0, x1, 0.07, 0.14, 1.7, _mats["brick"], -1.15)
		_slab(x0, x1, -0.30, 0.14, 2.4, _mats["asphalt"], 3.1)
	_slab(55.8, 59.2, -2.2, 0.3, 4.0, _mats["dark"])  # pit guts
	# continuous brick backs: buildings pressed against the playfield
	_wall(-10.0, 16.0, 7.0)
	_wall(16.0, 34.0, 6.0)
	_wall(34.0, 52.0, 8.0)
	_wall(52.0, 84.0, 7.5)
	_wall(84.0, 104.0, 6.5)
	_wall(104.0, 112.0, 6.5)  # backs the street behind the gate
	# solid ends: nowhere to run but forward
	_slab(-11.0, -10.0, 8.0, 8.0, 4.0, _mats["brick"])


func _wall(x0: float, x1: float, h: float) -> void:
	_slab(x0, x1, h, h, 0.6, _mats["brick"], -1.95)
	# sparse lit windows: somebody is always watching
	var rng := 0
	for wx in range(int(x0) + 2, int(x1) - 1, 3):
		rng += 1
		for wy in [2.8, 4.4]:
			if (rng + int(wy)) % 3 == 0:
				_quad(self, _mats["win_lit"], wx, wy, 0.55, 0.75, -1.62)
			else:
				_quad(self, _mats["win_dark"], wx, wy, 0.55, 0.75, -1.62)


