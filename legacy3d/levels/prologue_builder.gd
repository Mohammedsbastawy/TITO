# -------------------------------------------------------------- SEGMENT 3 -
func _car(x0: float, x1: float, van := false) -> void:
	var w := x1 - x0
	var body_h := 2.0 if van else 0.85
	_slab(x0, x1, body_h, body_h, 1.8, _mats["steel"], -0.4)
	if not van:
		_slab(x0 + w * 0.25, x1 - w * 0.2, 1.45, 0.6, 1.5, _mats["dark"], -0.45)
	# wheels
	var wg := CylinderMesh.new()
	wg.top_radius = 0.32
	wg.bottom_radius = 0.32
	wg.height = 0.24
	for wx in [x0 + 0.7, x1 - 0.7]:
		for wz in [0.45, -1.25]:
			var wheel := MeshInstance3D.new()
			wheel.mesh = wg
			wheel.material_override = _mats["dark"]
			wheel.rotation.x = PI * 0.5
			wheel.position = Vector3(wx, 0.32, wz)
			add_child(wheel)


