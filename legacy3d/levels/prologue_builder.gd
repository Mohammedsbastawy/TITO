# ------------------------------------------------------------- gameplay ---
func _spawn_enemy_script(script: Script, x: float, y_surface: float, min_x: float, max_x: float, tint: Color, aggr := 1.0) -> Node3D:
	var e := ENEMY.instantiate()
	e.set_script(script)
	e.set("patrol_min_x", min_x)
	e.set("patrol_max_x", max_x)
	e.set("base_tint", tint)
	e.set("aggression", aggr)
	e.position = Vector3(x, y_surface + 0.9, 0.0)  # BEFORE add_child: spawn cache
	add_child(e)
	return e


func _spawn_typed(scene_script: Script, x: float, min_x: float, max_x: float, tint: Color) -> Node3D:
	return _spawn_enemy_script(scene_script, x, 0.0, min_x, max_x, tint)


func _track_squad(e: Node3D) -> void:
	_squad_alive += 1
	var h: Node = e.get_node_or_null("Health")
	if h != null:
		h.died.connect(_on_squad_died)


func _on_squad_died() -> void:
	_squad_alive -= 1
	if _squad_alive <= 0 and not _outro_started:
		_breach_gate()


func _breach_gate() -> void:
	if _gate == null:
		return
	_gate_lamp.material_override = _mats["gate_g"]
	var ih := get_node_or_null("/root/InputHelper")
	if ih != null and ih.has_method("rumble_medium"):
		ih.rumble_medium()  # the street shakes as the gate sinks
	var tw := create_tween()
	tw.tween_property(_gate, "position:y", _gate.position.y - 4.6, 1.6) \
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	tw.tween_callback(_gate.queue_free)


