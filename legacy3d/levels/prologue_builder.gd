func _barrier(x: float) -> void:
	_slab(x, x + 0.14, 1.05, 1.05, 0.5, _mats["steel"], -0.2)
	_slab(x + 1.16, x + 1.3, 1.05, 1.05, 0.5, _mats["steel"], -0.2)
	for i in 3:
		var mat: Material = _mats["barrier_r"] if i % 2 == 0 else _mats["barrier_w"]
		_slab(x, x + 1.3, 1.02 - i * 0.2, 0.18, 0.42, mat, -0.2)


