func _on_intro_body(body: Node3D) -> void:
	if _intro_done or _boss == null or not body.is_in_group("player"):
		return
	_intro_done = true
	_tito.set_physics_process(false)
	_tito.velocity = Vector3.ZERO
	_play_lines(LINES_INTRO, Callable(self, "_intro_finished"))


func _play_lines(lines: Array, on_done: Callable) -> void:
	_cine_root.visible = true
	for item in lines:
		_spk.text = item[0]
		_spk.add_theme_color_override("font_color", item[1])
		_line_ar.text = item[2]
		_line_en.text = item[3]
		await get_tree().create_timer(item[4]).timeout
	_cine_root.visible = false
	on_done.call()


func _intro_finished() -> void:
	if is_instance_valid(_tito):
		_tito.set_physics_process(true)
	if _boss != null:
		_boss.begin_fight()


# ------------------------------------------------------------- the outro --
func _on_boss_died(boss: GhorabBoss) -> void:
	if _outro_started:
		return
	_outro_started = true
	# the Raven falls
	var tw := create_tween().set_parallel()
	tw.tween_property(boss, "rotation:z", -PI * 0.5 * signf(boss.get("_dir")) if boss.get("_dir") != 0.0 else -PI * 0.5, 0.7) \
		.set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
	tw.tween_property(boss, "position:y", boss.position.y + 0.55, 0.7)
	_run_outro()


func _run_outro() -> void:
	if is_instance_valid(_tito):
		_tito.set_physics_process(false)
	await get_tree().create_timer(1.6).timeout
	# counter-strike from the dark: headlights, a single shot, then nothing
	var wt := create_tween()
	wt.tween_property(_white, "color:a", 1.0, 0.12)
	wt.tween_interval(0.18)
	wt.tween_property(_white, "color:a", 0.0, 0.5)
	await wt.finished
	await get_tree().create_timer(0.35).timeout
	_black.color = Color(0, 0, 0, 1)  # the shot
	await get_tree().create_timer(0.9).timeout
	# flatline
	_ecg_vals.clear()
	_ecg.visible = true
	_ecg_t = 0.0
	await get_tree().create_timer(7.0).timeout
	_ecg.visible = false
	# the rewind hook
	_play_lines(LINES_OUTRO, Callable(self, "_to_chapter_one"))


func _ecg_sample(t: float) -> float:
	if t > 2.6:
		return randf_range(-0.03, 0.03)  # flat
	var ph := fposmod(t, 0.86) / 0.86
	if ph < 0.06:
		return -0.35
	if ph < 0.14:
		return 1.0
	if ph < 0.22:
		return -0.28
	if ph < 0.3:
		return 0.12
	return 0.0


func _redraw_ecg() -> void:
	var vp := get_viewport().get_visible_rect().size
	var base_y := vp.y * 0.45
	var n := maxi(_ecg_vals.size(), 2)
	var pts := PackedVector2Array()
	for i in n:
		var x := vp.x * 0.5 - (n * 0.5 - i) * 4.0
		pts.append(Vector2(x, base_y - _ecg_vals[i] * 42.0))
	_ecg.points = pts


func _to_chapter_one() -> void:
	var tw := create_tween()
	tw.tween_property(_black, "color:a", 1.0, 0.8)
	await tw.finished
	get_tree().change_scene_to_file(CHAPTER_ONE)
